// c64basic.ebnf - the Commodore 64 BASIC V2 subset understood by c64sh.
//
// Notation (golang.org/x/exp/ebnf):
//   Rule = ... .     defines a rule; the "." ends it
//   a | b            a or b
//   [ a ]            optional: a, zero or one time
//   { a }            repeated: a, zero or more times
//   ( a b )          grouping
//   "PRINT"          literal text, matched exactly (keywords are uppercase)
//   "a" … "z"        any single character in that range
//
// Uppercase rules are parser rules: they combine tokens.
// lowercase rules are lexer rules: they combine characters.
// Spaces and tabs between tokens are ignored.
//
// @spec GRAMMAR-001, GRAMMAR-002, GRAMMAR-003, GRAMMAR-004, GRAMMAR-005, GRAMMAR-010


// ---- Lines ---------------------------------------------------------

// A line typed at the prompt or read from a script: statements separated
// by colons, run left to right.
//   PRINT "FOO":PRINT "BAR"   -> FOO, then BAR on the next line
Line = Statement { ":" Statement } .

// A statement may be empty, so "::" and a line of only ":" are valid.
Statement = [ PrintStatement | RemStatement ] .


// ---- PRINT ---------------------------------------------------------

// PRINT writes its items, then a newline unless the last item is ";" or ",".
//   PRINT                  -> blank line
//   PRINT "HELLO"          -> HELLO
//   PRINT "A";"B"          -> AB
//   PRINT "A""B"           -> AB
//   PRINT "A","B"          -> A<tab>B
//   PRINT "A";             -> A, with no newline
PrintStatement = print { PrintItem } .

// A value to print, or a separator: ";" prints nothing, "," prints a tab.
PrintItem = Expression | ";" | "," .


// ---- REM -----------------------------------------------------------

// A comment. Everything after REM, to the end of the line, is ignored,
// including colons, so REM is always the last statement on its line.
//   REM GREET THE USER
//   PRINT "HI":REM SAYS HI     -> HI
//   REM A:PRINT "X"            -> (nothing)
RemStatement = rem .


// ---- Expressions (strings only, for now) ---------------------------

// Strings joined with "+". A joined string may hold at most 255 characters.
//   "A"+"B"                -> AB
Expression = string { "+" string } .


// ---- Tokens --------------------------------------------------------

// The PRINT keyword, or "?", its C64 abbreviation. No space is needed
// after it:  PRINT"HI"  -> HI
print = "PRINT" | "?" .

// A string literal. The closing quote is optional, as on a C64:
//   PRINT "HI   -> HI
string = `"` { character } [ `"` ] .

// The REM keyword and its comment: any characters, quotes included, to the
// end of the line. No space is needed after it:  REMARK  is a comment.
rem = "REM" { character | `"` } .

// Any character except a double quote or a line feed. (Input is split into
// lines at line feeds, so a line never contains one.)
character = "\x00" … "\t" | "\x0b" … "!" | "#" … "\U0010FFFF" .
